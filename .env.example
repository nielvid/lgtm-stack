# ============================================================
# LGTM Stack — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Grafana -----------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_strong_password
GF_SERVER_ROOT_URL=http://localhost:3000

# ---- Alertmanager / Slack ----------------------------------
# Slack incoming webhook URL for #DevOps-Alerts
# Get one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/THIS/WEBHOOK

# ---- Pushgateway -------------------------------------------
# Public URL of the Pushgateway reachable from GitHub Actions
# e.g., http://<VM-EXTERNAL-IP>:9091
PUSHGATEWAY_URL=http://REPLACE_WITH_VM_IP:9091

# ---- Prometheus --------------------------------------------
PROMETHEUS_RETENTION=15d

# ---- Loki --------------------------------------------------
LOKI_RETENTION=720h   # 30 days

# ---- Tempo -------------------------------------------------
TEMPO_RETENTION=168h  # 7 days

# ---- Demo App ----------------------------------------------
APP_PORT=8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Terraform / GCP ---------------------------------------
# Used only when running terraform — not loaded by the startup script automatically
TF_VAR_project_id=your-gcp-project-id
TF_VAR_zone=us-central1-a
TF_VAR_region=us-central1
TF_VAR_machine_type=e2-standard-2
TF_VAR_ssh_user=ubuntu
TF_VAR_ssh_pub_key_path=~/.ssh/id_rsa.pub
